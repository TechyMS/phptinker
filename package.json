{
  "name": "phptinker",
  "version": "1.0.0",
  "description": "An offline desktop scratchpad for running PHP, Composer, Laravel, and JavaScript code.",
  "author": "PHP Tinker contributors",
  "homepage": "https://github.com/TechyMS/phptinker",
  "desktopName": "com.phptinker.app.desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechyMS/phptinker.git"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node scripts/generate-notices.mjs",
    "predist": "node scripts/generate-notices.mjs",
    "predev": "node scripts/patch-electron-dev.js",
    "dev": "vite",
    "test": "node --test",
    "test:desktop": "vite build --config scripts/smoke.vite.config.js && electron scripts/desktop-smoke.mjs",
    "build": "vite build",
    "check": "npm test && npm run build",
    "dist": "vite build && electron-builder",
    "postinstall": "node scripts/patch-electron-dev.js"
  },
  "build": {
    "appId": "com.phptinker.app",
    "productName": "PHP Tinker",
    "asar": true,
    "compression": "maximum",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt",
      "build/icon.png",
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "maintainer": "Moolchand Sharma <moolchand390@gmail.com>",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vite-plugin-electron": "^1.1.2",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "monaco-editor": "^0.57.0"
  },
  "overrides": {
    "@electron/get": "5.1.0",
    "dompurify": "3.4.16",
    "fast-uri": "3.1.8"
  }
}
